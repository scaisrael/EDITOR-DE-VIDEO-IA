NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_ASR_MODEL=openai/whisper-large-v3
# true = no llama a ASR; si ASR falla, el pipeline usa mock igual salvo USE_MOCK_TRANSCRIPT=false
USE_MOCK_TRANSCRIPT=false
